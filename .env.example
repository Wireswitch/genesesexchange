# Postgres connection string. Recommended: a free Neon (https://neon.tech) or Vercel Postgres database.
# Must work both at build time and at runtime.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"

# Set to your deployed URL in production, e.g. https://geneses.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# Anthropic API key for AI-assisted scoring, matching and drafting.
ANTHROPIC_API_KEY="sk-ant-..."
# Optional override, defaults to claude-sonnet-5 if unset.
ANTHROPIC_MODEL="claude-sonnet-5"

# Vercel Blob token for document uploads (Storage tab -> Blob -> Create -> copy token).
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Used to seed an initial admin account (see prisma/seed.ts).
SEED_ADMIN_EMAIL="admin@geneses.example"
SEED_ADMIN_PASSWORD="ChangeMe123!"
